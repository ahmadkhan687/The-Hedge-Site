# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Public site URL used in subscriber emails (production domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Resend — https://resend.com (free tier available)
# Create an API key, then set EMAIL_FROM after verifying a domain
# (for testing you can use: The Hedge Collective <onboarding@resend.dev>)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=The Hedge Collective <onboarding@resend.dev>

# Optional secret for unsubscribe link signatures (falls back to RESEND_API_KEY)
UNSUBSCRIBE_SECRET=

# --- Pakistan study landing (password + private PDF) ---
# Page password visitors enter to unlock the study
STUDY_PAGE_PASSWORD=
# Optional dedicated cookie signing secret (falls back to STUDY_PAGE_PASSWORD)
STUDY_ACCESS_SECRET=
# Private Supabase Storage bucket + object path for the PDF
STUDY_PDF_BUCKET=
STUDY_PDF_PATH=
# Optional download filename (defaults to the file name in STUDY_PDF_PATH)
STUDY_PDF_FILENAME=
# Server-only: required to read a private Storage bucket
SUPABASE_SERVICE_ROLE_KEY=

# Server-only realtime feed (never NEXT_PUBLIC_ — browser must not see these)
FEED_UPSTREAM_URL=
FEED_API_TOKEN=
FEED_SEARCH_HASH=
